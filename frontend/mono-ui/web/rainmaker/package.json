{
  "name": "rainmaker",
  "version": "1.10.0-beta",
  "main": "",
  "repository": "",
  "license": "egov",
  "private": true,
  "scripts": {
    "clean": "lerna clean -f --yes && rm -rf node_modules",
    "reset": "yarn run clean && yarn i",
    "dev:employee": "yarn run build-css-employee && cd packages/employee && PORT=3006 yarn start",
    "prod:employee": "yarn run go_employee && cd packages/employee && yarn run build",
    "dev:employee-mcs": "cd dev-packages/egov-uc-dev &&  yarn start",
    "prod:employee-mcs": "yarn run go_employee_mcs && cd dev-packages/egov-uc-dev && yarn build",
    "transpile-common-modules": "run-p egov-ui-kit egov-ui-framework egov-common egov-hrms egov-inbox",
    "transpile-employee-modules": "run-p egov-hrms",
    "egov-ui-kit-config": "babel dev-packages/egov-ui-kit-dev/src/config --out-dir packages/lib/egov-ui-kit/config --copy-files",
    "egov-ui-kit-components": "babel dev-packages/egov-ui-kit-dev/src/components --out-dir packages/lib/egov-ui-kit/components --copy-files",
    "egov-ui-kit-redux": "babel dev-packages/egov-ui-kit-dev/src/redux --out-dir packages/lib/egov-ui-kit/redux --copy-files",
    "egov-ui-kit-utils": "babel dev-packages/egov-ui-kit-dev/src/utils --out-dir packages/lib/egov-ui-kit/utils --copy-files",
    "egov-ui-kit-commons": "babel dev-packages/egov-ui-kit-dev/src/common --out-dir packages/lib/egov-ui-kit/common --copy-files",
    "egov-ui-kit-custom-icons": "babel dev-packages/egov-ui-kit-dev/src/custom-icons --out-dir packages/lib/egov-ui-kit/custom-icons --copy-files",
    "egov-ui-kit-hocs": "babel dev-packages/egov-ui-kit-dev/src/hocs --out-dir packages/lib/egov-ui-kit/hocs --copy-files",
    "egov-ui-kit-assets": "babel dev-packages/egov-ui-kit-dev/src/assets --out-dir packages/lib/egov-ui-kit/assets --copy-files",
    "egov-ui-kit": "babel dev-packages/egov-ui-kit-dev/src --out-dir packages/lib/egov-ui-kit --copy-files",
    "build-css-employee": "run-p build-css-egov-inbox",
    "build-css-common-mcs": "run-p build-css-egov-ui-framework-core build-css-egov-uc ",
    "build-css-common": "run-p build-css-egov-ui-kit build-css-egov-ui-framework-core build-css-egov-common",
    "build-css-egov-ui-kit": "node-sass-chokidar dev-packages/egov-ui-kit-dev/src -o dev-packages/egov-ui-kit-dev/src",
    "build-css-egov-ui-framework-core": "node-sass-chokidar dev-packages/egov-ui-framework-core/src -o dev-packages/egov-ui-framework-core/src",
    "build-css-egov-tradelicence": "node-sass-chokidar dev-packages/egov-tradelicence-dev/src -o dev-packages/egov-tradelicence-dev/src",
    "build-css-egov-common": "node-sass-chokidar dev-packages/egov-common-dev/src -o dev-packages/egov-common-dev/src",
    "build-css-egov-inbox": "node-sass-chokidar dev-packages/egov-inbox-dev/src -o dev-packages/egov-inbox-dev/src",
    "egov-ui-framework-redux": "babel dev-packages/egov-ui-framework-core/src/ui-redux --out-dir packages/lib/egov-ui-framework/ui-redux --copy-files",
    "egov-ui-framework-utils": "babel dev-packages/egov-ui-framework-core/src/ui-utils --out-dir packages/lib/egov-ui-framework/ui-utils --copy-files",
    "egov-ui-framework-config": "babel dev-packages/egov-ui-framework-core/src/ui-config/screens/specs --out-dir packages/lib/egov-ui-framework/ui-config/screens/specs --copy-files",
    "egov-ui-framework-hocs": "babel dev-packages/egov-ui-framework-core/src/ui-hocs --out-dir packages/lib/egov-ui-framework/ui-hocs --copy-files",
    "egov-ui-framework-atoms": "babel dev-packages/egov-ui-framework-core/src/ui-atoms --out-dir packages/lib/egov-ui-framework/ui-atoms --copy-files",
    "egov-ui-framework-molecules": "babel dev-packages/egov-ui-framework-core/src/ui-molecules --out-dir packages/lib/egov-ui-framework/ui-molecules --copy-files",
    "egov-ui-framework-containers": "babel dev-packages/egov-ui-framework-core/src/ui-containers --out-dir packages/lib/egov-ui-framework/ui-containers --copy-files",
    "egov-ui-framework": "babel dev-packages/egov-ui-framework-core/src --out-dir packages/lib/egov-ui-framework --copy-files",
    "egov-tradelicence": "babel dev-packages/egov-tradelicence-dev/src --out-dir packages/lib/egov-tradelicence --copy-files",
    "egov-hrms": "babel dev-packages/egov-hrms-dev/src --out-dir packages/lib/egov-hrms --copy-files",
    "egov-common": "babel dev-packages/egov-common-dev/src --out-dir packages/lib/egov-common --copy-files",
    "egov-inbox": "babel dev-packages/egov-inbox-dev/src --out-dir packages/lib/egov-inbox --copy-files",
    "go": "yarn && yarn run build-css-employee && yarn run build-css-citizen && yarn run build-css-common && yarn run transpile-common-modules && yarn run transpile-citizen-modules && yarn run transpile-employee-modules && lerna bootstrap",
    "go_employee": "yarn && yarn run build-css-common && yarn run build-css-egov-inbox && yarn run transpile-common-modules && lerna bootstrap --ignore rainmaker-citizen --ignore pgr-citizen-dev --ignore pt-citizen-dev --ignore pgr-employee-dev --ignore pt-employee-dev",
    "go_citizen": "yarn  && yarn run build-css-citizen && yarn run build-css-common && yarn run transpile-common-modules && yarn run transpile-citizen-modules  && lerna bootstrap  --ignore egov-ui-framework-core --ignore egov-ui-kit-dev --ignore RNativeApp --ignore rainmaker-employee --ignore egov-hrms-dev  --ignore egov-tradelicence-dev --ignore egov-uc-dev --ignore egov-common-dev --ignore egov-hrms --ignore egov-inbox-dev --ignore egov-inbox",
    "go_employee_mcs": "yarn && yarn run build-css-common-mcs && yarn run transpile-common-modules-mcs && lerna bootstrap --ignore egov-ui-transform-service --ignore RNativeApp --ignore rainmaker-citizen --ignore rainmaker-employee --ignore egov-tradelicence --ignore egov-noc --ignore egov-ui-kit  --ignore egov-hrms-dev  --ignore egov-tradelicence-core --ignore egov-noc-dev",
    "pt": "yarn run egov-ui-kit &&yarn run egov-ui-framework && yarn run egov-common && yarn run egov-inbox",
    "non_pt": "yarn run egov-abg &&yarn run egov-bpa && yarn run egov-hrms && yarn run egov-noc && yarn run egov-tradelicence && yarn run egov-firenoc && yarn run egov-billamend && yarn run egov-uc && yarn run egov-bnd"
  },
  "devDependencies": {
    "babel-cli": "6.26.0",
    "babel-plugin-transform-runtime": "6.23.0",
    "babel-preset-es2015": "6.24.1",
    "babel-preset-react": "6.24.1",
    "babel-preset-stage-0": "6.24.1",
    "lerna": "3.17.0",
    "run-p": "0.0.0",
    "webpack": "4.29.0",
    "webpack-cli": "3.2.1"
  },
  "dependencies": {
    "classnames": "2.2.6",
    "node-sass": "npm:sass@1.50.0",
    "node-sass-chokidar": "1.3.4",
    "npm-run-all": "4.1.5"
  },
  "resolutions": {
    "glob": "7.2.3",
    "minimatch": "3.1.2",
    "jquery": "^3.6.0",
    "**/jquery": "^3.6.0"
  },
  "browserslist": [
    ">1%",
    "last 4 versions",
    "Firefox ESR",
    "not ie < 9"
  ]
}